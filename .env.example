# RentEZ — local development environment
# rentez_startup_project_v1_1_20260810_1421SGT
#
#   cp .env.example .env
#
# .env is git-ignored (root .gitignore lines 69-71). NOTHING in this file is a
# real credential — every value is a local throwaway so that no teammate needs
# an AWS account, or any real secret, just to write application code.

# ------------------------------------------------------------ host ports
# Only needed when something on your machine already owns a port. The
# CONTAINER ports never change; only the host side moves.
#   MYSQL_PORT=3307      # a local MySQL already holds 3306
#   GATEWAY_PORT=8081    # 8080 is the most contested port on any dev machine
#   DYNAMODB_PORT=8001
#   ADMINER_PORT=8091
#   FRONTEND_PORT=3001
# If you change MYSQL_PORT, set DB_PORT to match so IntelliJ (Mode A) follows.

# ---------------------------------------------------------------- MySQL
MYSQL_ROOT_PASSWORD=rentez

# Per-service database passwords.
#
# !! THESE MUST MATCH db/init/01-schemas.sql !!
# MySQL creates the users from that file on first boot; these values are what
# the services present when connecting. If they drift apart you get an opaque
# "Access denied for user" much later. `make check` compares them and fails.
AUTH_DB_PASSWORD=auth_pw
FLEET_DB_PASSWORD=fleet_pw
BOOKING_DB_PASSWORD=booking_pw
PAYMENT_DB_PASSWORD=payment_pw
NOTIFICATION_DB_PASSWORD=notification_pw

# ------------------------------------------------- DynamoDB Local / AWS SDK
# The AWS SDK requires *some* credentials to sign requests; DynamoDB Local does
# not validate them. DO NOT put real AWS keys here.
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=localsecret

# Used when running a service from IntelliJ (Mode A). Docker Compose sets the
# in-network equivalent (http://dynamodb:8000) itself.
RENTEZ_AWS_DYNAMODB_ENDPOINT=http://localhost:8000

# ---------------------------------------------------------- application
# HS256 requires at least 32 bytes. Generate your own:
#   openssl rand -base64 48
RENTEZ_JWT_SECRET=local-dev-secret-change-me-min-32-chars

# On AWS none of these exist in files — they are read from AWS Secrets Manager
# at deploy time and injected as a Kubernetes secret.
