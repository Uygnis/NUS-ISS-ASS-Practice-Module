 "cards": [
  {
   "dot": "cyan",
   "title": "Context relationships",
   "items": [
    "Identity publishes a language: JWT claims (role, userId), validated locally by every context",
    "Fleet is an open host service; Booking snapshots car data as its anti-corruption layer",
    "Payments and Booking are customer/supplier through idempotent confirm/cancel"
   ]
  },
  {
   "dot": "emerald",
   "title": "Producers and consumers",
   "items": [
    "Producers: staff and admins publish fleet, status and maintenance; contexts publish domain events",
    "Consumers: customers search, book and pay; Notification consumes events; the admin dashboard reads stats",
    "Public APIs return DTOs only; /internal/** needs a SERVICE token and is blocked at the edge"
   ]
  },
  {
   "dot": "amber",
   "title": "Rules that keep it a platform",
   "items": [
    "No cycles: availability lives in Booking, so Fleet calls nothing",
    "Domain events go through a transactional outbox, at-least-once",
    "Identity also reads Booking stats; any missing slice shows as partial, never zero",
    "Admins also issue refunds through Payments"
   ]
  }
 ]
