 "cards": [
  {
   "dot": "cyan",
   "title": "Dependency rules",
   "items": [
    "catalog and notification call nothing",
    "Nothing calls account at runtime: JWTs are validated locally",
    "account also reads reservation and payment stats, fail-soft (partial: true)"
   ]
  },
  {
   "dot": "rose",
   "title": "Correctness in the database",
   "items": [
    "booking_day (car_id, day) primary key blocks double-booking",
    "Unique idempotency_key makes payment retries safe",
    "Outbox rows commit with the business change; relay delivers over HTTP"
   ]
  },
  {
   "dot": "amber",
   "title": "Provisioned, not yet on the path",
   "items": [
