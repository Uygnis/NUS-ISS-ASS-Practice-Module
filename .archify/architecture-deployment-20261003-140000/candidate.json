 "cards": [
  {
   "dot": "cyan",
   "title": "Key physical decisions",
   "items": [
    "CloudFront is the only public entry: no CORS, no certificate, no domain",
    "One ALB for five services; spot nodes and no NAT gateway, about 70% cheaper",
    "Cluster Autoscaler grows the node group from 2 to 5 when pods are Pending"
   ]
  },
  {
   "dot": "amber",
   "title": "Two layers, two lifetimes",
   "items": [
    "Persistent (~$0.80/month): CloudFront, S3, ECR, SSM, SQS, DynamoDB, budgets",
    "Ephemeral (~$0.21/hour): EKS, ALB, RDS, created daily by make aws-up",
    "The lease Lambda deletes the ephemeral layer, so a forgotten cluster cannot run up a bill"
   ]
  },
  {
   "dot": "violet",
   "title": "Two environments",
   "items": [
    "rentez-dev and rentez-prod: own cluster, namespace, URL, RDS and log group",
    "Shared underneath: the VPC and the ECR repositories",
    "make aws-up-dev / aws-up-prod; a bare make aws-up asks which"
   ]
  }
 ]
